{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/*Panel.tsx",
    "components/solar-system/**/*.tsx",
    "components/VentureProcessTable.tsx",
    "components/VentureCrontabPanel.tsx",
    "components/SystemLog.tsx",
    "components/SysBootSequence.tsx",
    "components/SysBeacon.tsx",
    "components/LatencyMapPanel.tsx",
    "components/RecentCommitsPanel.tsx",
    "components/CIPipelinePanel.tsx",
    "components/NeofetchPanel.tsx",
    "components/MethodologyDiffPanel.tsx",
    "components/GitShortlogPanel.tsx",
    "components/BuildOutputPanel.tsx"
  ]
}
